[node name="PitchWobble" type="Button" parent="Layout/Buttons"]
layout_mode = 2
focus_mode = 0
toggle_mode = true
button_pressed = true
text = "pitch wobble"

[connection signal="toggled" from="Layout/Buttons/AlwaysVoice" to="." method="_on_always_voice_toggled"]
[connection signal="toggled" from="Layout/Buttons/PitchWobble" to="." method="_on_pitch_wobble_toggled"]
