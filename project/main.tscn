[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://main.gd" id="1"]
[ext_resource type="Script" path="res://voicebox.gd" id="2"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 24.0
offset_right = -24.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16

[node name="Voicebox" type="Control" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 0
script = ExtResource("2")

[node name="Buttons" type="HBoxContainer" parent="Layout"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 8

[node name="AlwaysVoice" type="Button" parent="Layout/Buttons"]
layout_mode = 2
focus_mode = 0
toggle_mode = true
button_pressed = true
